                </div>
            </div>
            <!-- ================= TRANG PHIM ẢNH ================= -->
            <div id="movie-page" class="page">
                <button class="btn-back" onclick="navigateTo('home-page')" title="Quay lại Trang Chủ">⬅</button>
                <div class="page-header-box">
                    <h2>🎬 Trạm Phim Ảnh</h2>
                    <p style="color: #666; font-size: 0.88rem;">Thư giãn với những bộ phim hay và đặc sắc</p>
                </div>
                <div class="mood-box">
                    <h3>Bạn muốn xem thể loại phim nào? 🍿</h3>
                    <div class="mood-buttons">
                        <button class="mood-btn" onclick="showMovieMood('history', this)">📜 Lịch sử Việt Nam</button>
                        <button class="mood-btn" onclick="showMovieMood('romance', this)">💖 Tình cảm lãng mạn</button>
                        <button class="mood-btn" onclick="showMovieMood('horror', this)">😱 Kinh dị</button>
                        <button class="mood-btn" onclick="showMovieMood('action', this)">🔥 Hành động</button>
                    </div>
                </div>
                <div id="movie-results" class="recommendation-section">
                    <h4 class="recommendation-title">🍿 Danh sách phim phù hợp</h4>
                    <div id="movie-item-list"></div>
