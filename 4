                        <div class="card-vertical"><img src="https://photo-resize-zmp3.zadn.vn/w600_r1x1_jpeg/cover/0/b/c/6/0bc6ef8c7090b9669dc299e25731e1d4.jpg"><div class="card-vertical-info"><h4>Don't Côi</h4><p>V-Pop Chill</p><span class="card-tag">Nhạc Việt</span></div></div>
                    </div>
                `;
            } else if (mood === 'sad') {
                list.innerHTML = `
                    <div class="vertical-grid-2col">
