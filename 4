            </div>
            <!-- ================= TRANG GAME ================= -->
            <div id="game-page" class="page">
                <button class="btn-back" onclick="navigateTo('home-page')" title="Quay lại Trang Chủ">⬅</button>
                <div class="page-header-box">
                    <h2>🎮 Trạm Game</h2>
                    <p style="color: #666; font-size: 0.88rem;">Khám phá thế giới ảo & xả stress sau giờ học</p>
                </div>
                <div class="mood-box">
                    <h3>Bạn muốn chơi thể loại game nào? 🎯</h3>
                    <div class="mood-buttons">
                        <button class="mood-btn" onclick="showGameMood('rpg', this)">⚔️ Game nhập vai (RPG)</button>
                        <button class="mood-btn" onclick="showGameMood('moba', this)">🏆 Multiplayer (5v5)</button>
                        <button class="mood-btn" onclick="showGameMood('relax', this)">🌿 Game thư giãn</button>
                        <button class="mood-btn" onclick="showGameMood('offline', this)">📱 Game offline</button>
