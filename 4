    <!-- JavaScript Xử Lý Toàn Bộ Sự Kiện Click & Chuyển Trang -->
    <script>
        function navigateTo(pageId) {
            let pages = document.querySelectorAll('.page');
            pages.forEach(p => p.style.display = 'none');
            document.getElementById(pageId).style.display = 'block';
            window.scrollTo({ top: 0, behavior: 'smooth' });
        }
        function updateActiveButton(btnElement) {
            let parentBox = btnElement.closest('.mood-box');
            let buttons = parentBox.querySelectorAll('.mood-btn');
            buttons.forEach(b => b.classList.remove('active'));
            btnElement.classList.add('active');
        }
        function showMusicMood(mood, btn) {
            updateActiveButton(btn);
            let section = document.getElementById('music-results');
            let list = document.getElementById('music-item-list');
            section.style.display = 'block';
            if (mood === 'happy') {
                list.innerHTML = `
                    <div class="vertical-grid-2col">
                        <div class="card-vertical"><img src="https://is1-ssl.mzstatic.com/image/thumb/Music126/v4/63/e5/e2/63e5e2e4-829b-924d-a1dc-8058a1d69bd4/196922462702_Cover.jpg/1200x1200bf-60.jpg"><div class="card-vertical-info"><h4>Super Shy</h4><p>NewJeans</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://is1-ssl.mzstatic.com/image/thumb/Music116/v4/7f/ca/13/7fca1315-9134-7937-b159-367bbed08dfa/AKMU_LoveLee_Cover_4000x4000.jpg/1200x1200bf-60.jpg"><div class="card-vertical-info"><h4>Love Lee</h4><p>AKMU</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://i1.sndcdn.com/artworks-000642097669-ltmdh8-t500x500.jpg"><div class="card-vertical-info"><h4>Blueming</h4><p>IU</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://thumb.wikimedia.org/wikipedia/en/thumb/8/81/Ive_%E2%80%93_After_Like.png/250px-Ive_%E2%80%93_After_Like.png"><div class="card-vertical-info"><h4>After LIKE</h4><p>IVE</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://upload.wikimedia.org/wikipedia/vi/d/db/BTS_-_Butter.png"><div class="card-vertical-info"><h4>Butter</h4><p>BTS</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://bloganchoi.com/wp-content/uploads/2024/08/mong-yu-lyrics-amee-mong-mi-2.jpg"><div class="card-vertical-info"><h4>Mộng Du</h4><p>AMEE ft. MCK</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://dep.com.vn/wp-content/uploads/2020/09/mv-em-be-2.jpg"><div class="card-vertical-info"><h4>Em Bé</h4><p>AMEE</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://i1.sndcdn.com/artworks-000659802700-e5zgxh-t500x500.jpg"><div class="card-vertical-info"><h4>Anh Nhà Ở Đâu Thế</h4><p>AMEE</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://i1.sndcdn.com/artworks-000492526992-wg4b2b-t1080x1080.jpg"><div class="card-vertical-info"><h4>Ex's Hate Me</h4><p>B Ray ft. AMEE</p><span class="card-tag">Nhạc Vui</span></div></div>
                        <div class="card-vertical"><img src="https://photo-resize-zmp3.zadn.vn/w600_r1x1_jpeg/cover/b/6/d/e/b6de6c0857b19e1c921f2d379817d491.jpg"><div class="card-vertical-info"><h4>Hai Mươi Hai (22)</h4><p>Hứa Kim Tuyền x AMEE</p><span class="card-tag">Nhạc Vui</span></div></div>
                    </div>
                `;
            } else if (mood === 'study') {
                list.innerHTML = `
                    <div class="vertical-grid-2col">
                        <div class="card-vertical"><img src="https://images.genius.com/96fab843dc59f3be9ec6e577de8552fa.1000x1000x1.png"><div class="card-vertical-info"><h4>Blue</h4><p>Yung Kai</p><span class="card-tag">Học Bài / Chill</span></div></div>
                        <div class="card-vertical"><img src="https://i1.sndcdn.com/artworks-xz3EIz3KnM4bjotQ-4wngBQ-t500x500.jpg"><div class="card-vertical-info"><h4>Sunset Lover</h4><p>Petit Biscuit</p><span class="card-tag">Học Bài / Chill</span></div></div>
                        <div class="card-vertical"><img src="https://i.scdn.co/image/ab67616d0000b273c9fd6014bf7236a78d27a383"><div class="card-vertical-info"><h4>Coffee Breath</h4><p>Sofia Mills</p><span class="card-tag">Học Bài / Chill</span></div></div>
